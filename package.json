{
  "name": "@o1-labs/mina-archive-sdk",
  "version": "2.0.0",
  "description": "TypeScript/JavaScript SDK for interacting with Mina Archive Node GraphQL endpoints",
  "repository": {
    "type": "git",
    "url": "https://github.com/o1-labs/mina-archive-sdk-js"
  },
  "homepage": "https://github.com/o1-labs/mina-archive-sdk-js",
  "bugs": "https://github.com/o1-labs/mina-archive-sdk-js/issues",
  "license": "Apache-2.0",
  "author": "O(1) Labs <build@o1labs.org>",
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js",
      "default": "./build/src/index.js"
    }
  },
  "files": [
    "build/src",
    "src",
    "schema.graphql",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "keywords": [
    "mina",
    "mina-protocol",
    "archive-node",
    "graphql",
    "sdk",
    "blockchain",
    "zkapp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf build && tsc",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --enable-source-maps --test ./build/tests/*.test.js",
    "test:integration": "npm run build && node --enable-source-maps --test --test-timeout 120000 ./build/tests/integration.test.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'examples/**/*.ts'",
    "check-schema-drift": "bash scripts/check_schema_drift.sh",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/generated",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@types/node": "^20.5.7",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "eslint": "^8.48.0",
    "graphql": "^16.14.2",
    "prettier": "3.0.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2"
  }
}
